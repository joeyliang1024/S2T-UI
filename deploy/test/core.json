          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "S2T_PROCESS_ROLE",
                    "value": "api"
                  },
                  {
                    "name": "REDIS_SENTINEL_USERNAME",
                    "value": "default"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "s2t-stress-config"
                    }
                  }
                ],
                "image": "s2t-stress:20261006-telemetry-backpressure",
                "imagePullPolicy": "IfNotPresent",
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "node",
                        "-e",
                        "process.kill(1, \"SIGUSR2\"); setTimeout(() => {}, 10000)"
                      ]
                    }
                  }
                },
                "name": "gateway",
                "ports": [
                  {
                    "containerPort": 8787,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8787,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 1,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
