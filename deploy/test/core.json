    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "redis",
        "namespace": "s2t-stress-20261005"
      },
      "spec": {
        "persistentVolumeClaimRetentionPolicy": {
          "whenDeleted": "Retain",
          "whenScaled": "Retain"
        },
        "podManagementPolicy": "Parallel",
        "replicas": 3,
        "selector": {
          "matchLabels": {
            "app": "redis"
          }
        },
        "serviceName": "redis",
        "template": {
          "metadata": {
            "labels": {
              "app": "redis"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "sh",
                  "-c",
                  "set -eu\nmaster=\"\"\nfor i in 0 1 2; do\n master=$(redis-cli -h sentinel-$i.sentinel -p 26379 -a \"$SENTINEL_PASSWORD\" --no-auth-warning --raw SENTINEL get-master-addr-by-name s2t-stress-master 2>/dev/null | head -n 1) || true\n [ -n \"$master\" ] && break\ndone\nif [ -z \"$master\" ]; then master=redis-0.redis.s2t-stress-20261005.svc.cluster.local; fi\nown=\"$HOSTNAME.redis.s2t-stress-20261005.svc.cluster.local\"\nif [ \"$master\" = \"$own\" ]; then\n exec redis-server --repl-diskless-sync-delay 0 --requirepass \"$REDIS_PASSWORD\" --masterauth \"$REDIS_PASSWORD\" --appendonly yes --dir /data --replica-announce-ip \"$own\" --replica-announce-port 6379\nelse\n exec redis-server --repl-diskless-sync-delay 0 --requirepass \"$REDIS_PASSWORD\" --masterauth \"$REDIS_PASSWORD\" --appendonly yes --dir /data --replicaof \"$master\" 6379 --replica-announce-ip \"$own\" --replica-announce-port 6379\nfi"
                ],
                "env": [
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s2t-test-services",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SENTINEL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s2t-test-services",
                        "key": "SENTINEL_PASSWORD"
                      }
                    }
                  }
                ],
                "image": "redis:7.4-alpine",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -a \"$REDIS_PASSWORD\" --no-auth-warning ping | grep PONG"
                    ]
                  },
                  "failureThreshold": 6,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "name": "redis",
                "ports": [
                  {
                    "containerPort": 6379,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -a \"$REDIS_PASSWORD\" --no-auth-warning ping | grep PONG"
                    ]
                  },
                  "failureThreshold": 3,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -a \"$REDIS_PASSWORD\" --no-auth-warning ping | grep PONG"
                    ]
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 3,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 45
          }
        },
        "updateStrategy": {
          "rollingUpdate": {
            "maxUnavailable": 1,
            "partition": 0
          },
          "type": "RollingUpdate"
        },
        "volumeClaimTemplates": [
          {
            "apiVersion": "v1",
            "kind": "PersistentVolumeClaim",
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "512Mi"
                }
              },
              "volumeMode": "Filesystem"
            },
            "status": {
              "phase": "Pending"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "sentinel",
        "namespace": "s2t-stress-20261005"
      },
      "spec": {
        "persistentVolumeClaimRetentionPolicy": {
          "whenDeleted": "Retain",
          "whenScaled": "Retain"
        },
        "podManagementPolicy": "Parallel",
        "replicas": 3,
        "selector": {
          "matchLabels": {
            "app": "sentinel"
          }
        },
        "serviceName": "sentinel",
        "template": {
          "metadata": {
            "labels": {
              "app": "sentinel"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "sh",
                  "-c",
                  "set -eu\nif [ ! -f /data/sentinel.conf ]; then\ncat > /data/sentinel.conf <<CFG\nport 26379\nbind 0.0.0.0\nprotected-mode yes\nrequirepass $SENTINEL_PASSWORD\nsentinel resolve-hostnames yes\nsentinel announce-hostnames yes\nsentinel announce-ip $HOSTNAME.sentinel.s2t-stress-20261005.svc.cluster.local\nsentinel monitor s2t-stress-master redis-0.redis.s2t-stress-20261005.svc.cluster.local 6379 2\nsentinel auth-pass s2t-stress-master $REDIS_PASSWORD\nsentinel sentinel-pass $SENTINEL_PASSWORD\nsentinel down-after-milliseconds s2t-stress-master 2000\nsentinel failover-timeout s2t-stress-master 15000\nsentinel parallel-syncs s2t-stress-master 1\nCFG\nfi\nsed -i '/^sentinel announce-ip /d; /^sentinel announce-hostnames /d; /^sentinel resolve-hostnames /d' /data/sentinel.conf\nprintf 'sentinel resolve-hostnames yes\\nsentinel announce-hostnames yes\\nsentinel announce-ip %s\\n' \"$HOSTNAME.sentinel.s2t-stress-20261005.svc.cluster.local\" >> /data/sentinel.conf\nexec redis-server /data/sentinel.conf --sentinel"
                ],
                "env": [
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s2t-test-services",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SENTINEL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s2t-test-services",
                        "key": "SENTINEL_PASSWORD"
                      }
                    }
                  }
                ],
                "image": "redis:7.4-alpine",
                "imagePullPolicy": "IfNotPresent",
                "name": "sentinel",
                "ports": [
                  {
                    "containerPort": 26379,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -p 26379 -a \"$SENTINEL_PASSWORD\" --no-auth-warning ping | grep PONG"
                    ]
                  },
                  "failureThreshold": 3,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -p 26379 -a \"$SENTINEL_PASSWORD\" --no-auth-warning ping | grep PONG"
                    ]
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 3,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  }
                ]
              }
            ],
