{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "mock-models",
        "namespace": "s2t-stress-20261005",
        "labels": {}
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "mock-models"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mock-models"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "node",
                  "/mocks/mock-services.cjs"
                ],
                "image": "node:22-bookworm-slim",
                "imagePullPolicy": "IfNotPresent",
                "name": "mock-models",
                "ports": [
                  {
                    "containerPort": 9090,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/healthz",
                    "port": 9090,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "250m",
                    "memory": "128Mi"
                  }
                },
                "startupProbe": {
                  "failureThreshold": 90,
                  "httpGet": {
                    "path": "/healthz",
                    "port": 9090,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/mocks",
                    "name": "mock-code"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 45,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "mock-model-code"
                },
                "name": "mock-code"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "mock-models",
        "namespace": "s2t-stress-20261005",
        "labels": {}
      },
      "spec": {
        "ports": [
          {
            "name": "p9090",
            "port": 9090,
            "protocol": "TCP",
            "targetPort": 9090
          }
        ],
        "selector": {
          "app": "mock-models"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "load-client",
        "namespace": "s2t-stress-20261005",
        "labels": {
          "app": "load-client"
        }
      },
      "spec": {
        "containers": [
          {
            "command": [
              "node",
              "-e",
              "setInterval(()=>{},100000)"
            ],
            "image": "node:22-bookworm-slim",
            "imagePullPolicy": "IfNotPresent",
            "name": "load-client",
            "resources": {
              "limits": {
                "memory": "768Mi"
              },
              "requests": {
                "cpu": "250m",
                "memory": "128Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/test",
                "name": "code"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": true,
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "tolerations": [
          {
            "effect": "NoExecute",
            "key": "node.kubernetes.io/not-ready",
            "operator": "Exists",
            "tolerationSeconds": 300
          },
          {
            "effect": "NoExecute",
            "key": "node.kubernetes.io/unreachable",
            "operator": "Exists",
            "tolerationSeconds": 300
          }
        ],
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "load-test-code"
            },
            "name": "code"
          }
        ],
        "automountServiceAccountToken": false
      }
    }
  ]
}
