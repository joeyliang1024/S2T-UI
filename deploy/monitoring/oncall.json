{
  "schemaVersion": 41,
  "version": 1,
  "timezone": "Asia/Taipei",
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "S2T",
    "值班"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "usage_department",
        "label": "部門",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(s2t_user_requests_total{job=\"$caption_gateway\",department!=\"\"}, department)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "datasource",
        "label": "資料來源",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {
          "text": "Prometheus",
          "value": "s2t-prometheus"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "caption_gateway",
        "label": "字幕量測來源",
        "type": "custom",
        "query": "8787 網頁入口 : gateway-web",
        "current": {
          "text": "8787 網頁入口",
          "value": "gateway-web"
        },
        "options": [
          {
            "text": "8787 網頁入口",
            "value": "gateway-web",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "usage_user",
        "label": "使用量 NT",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(s2t_user_requests_total{job=\"$caption_gateway\",department=~\"$usage_department\",department!=\"\"}, nt)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "description": "E2E P90、t1～t7 平均、API 成功率、部門使用趨勢與漏斗、Storage 健康狀態。",
  "uid": "s2t-oncall",
  "title": "S2T · 值班總覽｜延遲・部門・健康",
  "panels": [
    {
      "id": 1,
      "title": "00 · E2E：最後語音字 → 譯文最後字（ASR → 原文最後字）· 目標 ≤ 3s",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "E2E P90 · 最後語音字 → 譯文最後字（目標 ≤ 3 秒）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.90, sum(rate(s2t_caption_stage_duration_seconds_bucket{job=\"$caption_gateway\",stage=\"e2e_translation_tail\"}[$__range])) by (le)) and on() (sum(increase(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",stage=\"e2e_translation_tail\"}[$__range])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "所選時間區間；最後 VAD 語音樣本到該段譯文於可見即時頁呈現，包含斷句等待。VAD 為語音尾端估計，非逐字對齊；翻譯關閉或無樣本時無資料。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 170
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "ASR P90 · 最後語音字 → 原文最後字",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.90, sum(rate(s2t_caption_stage_duration_seconds_bucket{job=\"$caption_gateway\",stage=\"e2e_asr\"}[$__range])) by (le)) and on() (sum(increase(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",stage=\"e2e_asr\"}[$__range])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "所選時間區間 P90；使用者講完最後一字（最後 VAD 語音樣本）到原文最後一字於可見即時頁呈現，包含斷句等待；語音尾端為 VAD 估計，非逐字對齊。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 170
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "API 成功率（所選區間）",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(rate(s2t_gateway_request_errors_total{job=\"$caption_gateway\"}[$__range])) / sum(rate(s2t_gateway_request_duration_seconds_count{job=\"$caption_gateway\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "HTTP 狀態 < 400 / 全部完成請求；無請求時無資料。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 170
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "t1～t7 各階段平均耗時（秒）",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (rate(s2t_caption_phase_duration_seconds_sum{job=\"$caption_gateway\",phase=~\"t[1-7]\"}[$__range])) / (sum by (phase) (rate(s2t_caption_phase_duration_seconds_count{job=\"$caption_gateway\",phase=~\"t[1-7]\"}[$__range])) > 0)",
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "t1～t7 各階段平均耗時，t2 僅 VAD 邏輯處理；不同樣本的平均不可直接加總為 E2E。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "t1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t1 音訊擷取與上傳"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t2"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t2 VAD 邏輯處理"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t3"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t3 ASR 模型推論"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t4"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t4 文字後處理"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t5"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t5 回傳轉錄與呈現"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t6"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t6 翻譯模型"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t7"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t7 翻譯回傳與呈現"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 52,
      "title": "t1～t7 Detail 平均耗時（秒）",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (increase(s2t_caption_stage_duration_seconds_sum{job=\"$caption_gateway\",stage=~\"t[1-7]_.*\",stage!=\"t2_segment\"}[$__range])) / (sum by (stage) (increase(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",stage=~\"t[1-7]_.*\",stage!=\"t2_segment\"}[$__range])) > 0)",
          "legendFormat": "{{stage}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "各階段的細項平均耗時，t2 僅 VAD 邏輯處理；排除講話與區段累積時間。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 30,
      "title": "04 · Storage 健康狀態",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 31,
      "title": "PostgreSQL healthy",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(pg_up{job=\"postgres\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "1=健康，0=異常；缺失顯示無資料。MinIO／Milvus 此處只確認 metrics endpoint 可達，不代表完整讀寫驗證。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "異常",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 170
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
