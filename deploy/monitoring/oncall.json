        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "有效字幕樣本（最近 5 分鐘）",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",stage=\"e2e_asr\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "無有效樣本時，延遲分位數不能用來判斷服務正常。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "瓶頸階段（5 分鐘平均最慢）",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, sum by (phase) (rate(s2t_caption_stage_duration_seconds_sum{job=\"$caption_gateway\",phase=~\"t[1-5]\"}[5m])) / sum by (phase) (rate(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",phase=~\"t[1-5]\"}[5m])))",
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "t1~t5 中平均耗時最長的階段名稱（rate(_sum)/rate(_count) 取最大）；比值＝平均耗時。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "t1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t1 音訊擷取與上傳"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t2"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t2 VAD 偵測與分段"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t3"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t3 ASR 模型推論"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t4"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t4 文字後處理"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t5"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t5 回傳轉錄與呈現"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "textMode": "name"
      }
    },
    {
      "id": 8,
      "title": "各階段平均耗時｜最長者即瓶頸（所選範圍）",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (phase) (increase(s2t_caption_stage_duration_seconds_sum{job=\"$caption_gateway\",phase=~\"t[1-5]\"}[$__range])) / sum by (phase) (increase(s2t_caption_stage_duration_seconds_count{job=\"$caption_gateway\",phase=~\"t[1-5]\"}[$__range])))",
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "t1~t5 平均耗時由長到短排列：t3 大＝ASR 模型推論吃緊，t1 大＝上傳／編碼，t5 大＝回傳網路與重試。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "t1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t1 音訊擷取與上傳"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t2"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t2 VAD 偵測與分段"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t3"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t3 ASR 模型推論"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t4"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t4 文字後處理"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t5"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "t5 回傳轉錄與呈現"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "calcs": [
          "last"
        ],
        "fields": "",
        "values": false
      }
    },
