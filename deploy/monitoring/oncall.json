    {
      "id": 13,
      "title": "ASR 音訊量（所選範圍）",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(s2t_user_audio_seconds_total{job=\"$caption_gateway\",nt!=\"\",department!=\"\",user_id!=\"__overflow__\",operation=\"transcriptions\"}[$__range])) / 3600",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "成功完成的可解析 WAV 音訊量；未知格式時長不估算。",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:小時",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
