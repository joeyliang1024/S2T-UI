      }
    },
    {
      "id": 14,
      "title": "模型權杖數（所選範圍）",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(s2t_user_input_tokens_total{job=\"$caption_gateway\",nt!=\"\",department!=\"\",user_id!=\"__overflow__\"}[$__range])) + sum(increase(s2t_user_output_tokens_total{job=\"$caption_gateway\",nt!=\"\",department!=\"\",user_id!=\"__overflow__\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "翻譯／摘要模型回報的輸入與輸出 token；未回報部分請查看詳細總覽。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
