{
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "S2T",
    "值班"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "資料來源",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {
          "text": "Prometheus",
          "value": "s2t-prometheus"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "caption_gateway",
        "label": "字幕量測來源",
        "type": "custom",
        "query": "8787 網頁入口 : gateway-web,K8s 測試站 : s2t,驗收模擬資料（非正式） : gateway-acceptance",
        "current": {
          "text": "8787 網頁入口",
          "value": "gateway-web"
        },
        "options": [
          {
            "text": "8787 網頁入口",
            "value": "gateway-web",
            "selected": true
          },
          {
            "text": "K8s 測試站",
            "value": "s2t",
            "selected": false
          },
          {
            "text": "驗收模擬資料（非正式）",
            "value": "gateway-acceptance",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "usage_department",
        "label": "部門",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(s2t_user_requests_total{job=\"$caption_gateway\",department!=\"\"}, department)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "usage_user",
        "label": "使用量 NT",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(s2t_user_requests_total{job=\"$caption_gateway\",department=~\"$usage_department\",department!=\"\"}, nt)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "uid": "s2t-oncall",
  "title": "S2T · 值班總覽｜延遲・使用者・請求",
  "panels": [
    {
      "id": 1,
      "title": "01 · 延遲｜語音到字幕（來源：$caption_gateway）",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "字幕 P50（最近 5 分鐘）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(s2t_caption_stage_duration_seconds_bucket{job=\"$caption_gateway\",stage=\"e2e_asr\"}[5m])) by (le))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "完整落在即時字幕頁可見期間的 chunk 語音起點到原文呈現；包含音訊累積與排隊，缺少樣本時顯示無資料。分位數是 histogram 估算。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
