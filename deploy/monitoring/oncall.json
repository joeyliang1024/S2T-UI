    {
      "id": 37,
      "title": "部門 · 使用趨勢與轉換（L2 = 按開始錄音）",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 38,
      "title": "使用人數趨勢 · L2 不重複使用者",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
