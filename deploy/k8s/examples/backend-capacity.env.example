# Measured test profile; merge into backend/.env.k8s alongside real service credentials.
# This is not a 500-user certificate: workload cadence and report outcome matter.
S2T_WEB_WORKERS=4
S2T_HTTP_ACTIVE_PER_WORKER=64
S2T_POSTGRES_POOL_MAX=16
S2T_POSTGRES_FENCE_SESSIONS=16
S2T_ASR_MAX_INFLIGHT=512
S2T_TRANSLATION_MAX_INFLIGHT=512
S2T_BACKGROUND_MAX_INFLIGHT=8
# Two Pods: 8 * (16 main + 17 fencing + 1 health) = 272 SQL connections.
# One rolling surge Pod: 12 * 34 = 408; the isolated test PostgreSQL maximum is 448.
