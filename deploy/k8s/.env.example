K8S_NAMESPACE=s2t-web
# K8S_CONTEXT=your-context
# Set this to the cluster DNS Service IP.
K8S_DNS_RESOLVER=10.43.0.10
FRONTEND_IMAGE=YOUR_REGISTRY/s2t-frontend:IMMUTABLE_TAG
BACKEND_IMAGE=YOUR_REGISTRY/s2t-backend:IMMUTABLE_TAG
# Local single-node cluster only; production uses s2t-models PVC.
# K8S_MODEL_HOST_PATH=/absolute/path/to/models
# Default: package ./data/jargon/jargon_en.csv as a ConfigMap for both backend Pods.
# K8S_JARGON_FILE=/absolute/path/to/jargon_en.csv
# For CSVs larger than 900 KiB, mount an existing shared PVC instead.
# It must contain jargon_en.csv at its root and support reads from all backend Pods.
# K8S_JARGON_PVC=shared-jargon
