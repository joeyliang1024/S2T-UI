# Re-resolve service DNS after replacements, retaining a bounded idle pool.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;
upstream s2t_api {
    zone s2t_api 64k;
    server ${BACKEND_PROXY_AUTHORITY} resolve;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 10s;
}

server {
    listen ${FRONTEND_PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /livez {
        access_log off;
        return 200 'ok';
    }

    location = /api { return 404; }

    location /api/ {
        client_max_body_size 2g;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_PROXY_HOST};
        proxy_pass ${BACKEND_PROXY_SCHEME}://s2t_api;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_next_upstream off;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
