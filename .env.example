# 複製為 .env，填入正式部署必填值；不要提交 .env。
# 首次建立管理員需要帳號及至少 12 字元的密碼。
# S2T_AUTH_SECRET 請使用長且隨機的值，部署後持續沿用。
S2T_AUTH_SECRET=
S2T_BOOTSTRAP_ADMIN_USERNAME=
S2T_BOOTSTRAP_ADMIN_PASSWORD=

# 模型、Postgres／MinIO／Milvus、Docker 建置及其他選填參數：
# docs/guide/ENVIRONMENT-OPTIONS.zh-TW.md
# 本機 Docker 儲存範例：.env.local-storage.example
