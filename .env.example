# Electron 主程序讀取；請複製為 .env 後填入實際 key。不要提交 .env。
S2T_ASR_API_KEY=
S2T_ASR_ENDPOINT=https://submissions-enter-audit-workstation.trycloudflare.com/v1/audio/transcriptions
S2T_ASR_MODEL=Breeze-ASR-25
VITE_S2T_ASR_ENDPOINT=https://submissions-enter-audit-workstation.trycloudflare.com/v1/audio/transcriptions
VITE_S2T_ASR_MODEL=Breeze-ASR-25

# Web BFF reads the secret server-side and exposes only /api/config and
# /api/transcriptions. It falls back to S2T_ASR_* when these are unset.
S2T_WEB_PORT=8787
S2T_WEB_ASR_NAME=Breeze-ASR-25
# Comma-separated browser origins allowed to call a separately hosted BFF.
S2T_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 翻譯與摘要若使用不同 API，可各自設定 endpoint／model（在 UI）與 key。
S2T_TRANSLATION_API_KEY=
S2T_SUMMARY_API_KEY=
