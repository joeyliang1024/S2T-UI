# 請複製為 .env 後填入實際值；不要提交 .env。Electron 與 Web gateway 共用這些設定。
S2T_ASR_API_KEY=
# Example endpoint: https://host.example/v1/audio/transcriptions
S2T_ASR_ENDPOINT=
S2T_ASR_MODEL=
# Optional JSON array for multiple environment-provided ASR profiles.
S2T_ASR_MODELS_JSON=

S2T_TRANSLATION_API_KEY=
# Example endpoint: https://host.example/v1/chat/completions
S2T_TRANSLATION_ENDPOINT=
S2T_TRANSLATION_MODEL=

S2T_SUMMARY_API_KEY=
S2T_SUMMARY_ENDPOINT=
S2T_SUMMARY_MODEL=

# Speaker diarization model selection (restart gateway / Electron after changes).
# Local CPU Nemotron: MODEL=nemotron-3-diarization; ENDPOINT and API_KEY empty.
# Local sherpa: MODEL=sherpa-onnx-speaker-diarization; ENDPOINT and API_KEY empty.
# Remote: set MODEL, ENDPOINT and API_KEY to your service configuration.
# Empty MODEL + ENDPOINT falls back to sherpa; it does not disable diarization.
# S2T_MODELS_DIR selects the model root directory, not the backend.
S2T_DIARIZATION_API_KEY=
S2T_DIARIZATION_ENDPOINT=
S2T_DIARIZATION_MODEL=nemotron-3-diarization

# Web gateway 設定。API key 不會傳到瀏覽器，也不需要 VITE_ 變數。
S2T_WEB_PORT=8787
# Per authenticated account, per gateway process. Invalid values fall back to
# 180. These local limits do not change your model provider's API quota.
S2T_ASR_REQUESTS_PER_MINUTE=180
S2T_TRANSLATION_REQUESTS_PER_MINUTE=180
# Add the packaged Electron origin (normally `null`) only when required by
# the deployed gateway's CORS policy.
S2T_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Process role for layered deployments: `all` (default; one process serves API
# and audio jobs), `api`, or `audio-worker`. The audio-worker role only exposes
# the /livez, /readyz and /metrics probes.
S2T_PROCESS_ROLE=all
# Graceful-shutdown budget in milliseconds before in-flight jobs are dropped.
S2T_SHUTDOWN_GRACE_MS=25000
# `true` requires shared MinIO/PostgreSQL/Milvus storage and a shared
# S2T_AUTH_SECRET. Invalid settings keep /livez available but make /readyz
# return 503, so configure the Kubernetes liveness probe for /livez and the
# readiness probe for /readyz.
S2T_KUBERNETES_MODE=false

# Server logging (stdout; one line per event, no log files).
# S2T_LOG_LEVEL: debug | info | warn | error | silent — default `info`. Use
#   `debug` only while investigating: it prints every request, ASR chunk and
#   translation call, which floods the console under load.
# S2T_LOG_FORMAT: text (default, human-readable) | json (one object per line
#   for Kubernetes log queries).
# Every line carries role, pod (HOSTNAME) and — inside an HTTP request — the
# requestId returned to the client in the x-request-id header. Credentials,
# audio, transcripts and prompts are never printed.
S2T_LOG_LEVEL=info
S2T_LOG_FORMAT=text

# Session cookie hardening. Defaults (Strict, no Secure) fit local HTTP. Use
# SameSite=None only for cross-site deployments and always pair it with
# S2T_COOKIE_SECURE=true behind HTTPS.
S2T_COOKIE_SAME_SITE=Strict
S2T_COOKIE_SECURE=false

# Required by packaged Electron. This is an external HTTPS gateway; Electron
# never starts an embedded production gateway. Local HTTP is development-only.
S2T_GATEWAY_URL=https://gateway.example

# Set a long, random value for deployments. In local development a private
# value is generated under S2T_LOCAL_DATA_DIR so sessions survive restarts.
S2T_AUTH_SECRET=
S2T_BOOTSTRAP_ADMIN_USERNAME=admin
S2T_BOOTSTRAP_ADMIN_PASSWORD=admin

# Storage. Each service uses the local test adapter when every variable in its
# group is empty. Do not partially configure a group.
S2T_MINIO_ENDPOINT=http://127.0.0.1:9000
S2T_MINIO_BUCKET=s2t-audio
S2T_MINIO_ACCESS_KEY=s2t-local-minio
S2T_MINIO_SECRET_KEY=replace-with-a-local-minimum-12-character-secret

S2T_POSTGRES_HOST=127.0.0.1
S2T_POSTGRES_PORT=5432
S2T_POSTGRES_DB_NAME=s2t
S2T_POSTGRES_USER=s2t
S2T_POSTGRES_PASSWORD=replace-with-a-local-password
# Optional connection-pool ceiling for the remote PostgreSQL adapter (default 10).
S2T_POSTGRES_MAX_CONNECTIONS=10

S2T_MILVUS_ENDPOINT=127.0.0.1:19530
S2T_MILVUS_DB_NAME=default
S2T_MILVUS_COLLECTION=s2t_voiceprints
S2T_MILVUS_TOKEN=local-milvus-token

# Optional local storage location for development and tests.
S2T_LOCAL_DATA_DIR=.s2t-data

# Shared-storage safety valves (leave empty for the defaults).
# Cleanup intents recorded before an upload or voiceprint enrolment is
# committed by a later request are protected from reconciliation for this many
# milliseconds (default 30000; 0 disables the protection).
S2T_STORAGE_COMPENSATION_GRACE_MS=
# Durable diarization jobs are given up on after this many attempts, so a job
# that can never succeed stops re-running inference (default 10).
S2T_DIARIZATION_JOB_MAX_ATTEMPTS=

# Voiceprint matching and metadata. The threshold is between 0 and 1;
# defaults are used when these values are empty.
S2T_VOICEPRINT_THRESHOLD=
# Minimum cosine-score lead over the second candidate. A higher value reduces
# false identities at the cost of leaving more clips anonymous.
S2T_VOICEPRINT_MARGIN=0.05
S2T_VOICEPRINT_EMBEDDING_MODEL_NAME=
S2T_VOICEPRINT_EMBEDDING_VERSION=
# Consensus labelling. A first block must reach FAST_SCORE with a FAST_MARGIN
# lead to label a turn on its own; otherwise MIN_BLOCKS independent blocks of
# the same speaker must clear the threshold. Set MIN_BLOCKS=1 to accept a
# single block, S2T_VOICEPRINT_LOG=0 to silence the decision log.
S2T_VOICEPRINT_FAST_SCORE=0.75
S2T_VOICEPRINT_FAST_MARGIN=0.15
S2T_VOICEPRINT_MIN_BLOCKS=2
# Leading identities that the remaining blocks are verified against.
S2T_VOICEPRINT_CANDIDATE_BLOCKS=3
S2T_VOICEPRINT_LOG=1

# Bounded voiceprint inputs (seconds / dBFS). A diarized speaker is cut into at
# most MAX_BLOCKS blocks of MAX_BLOCK_SEC each and never more than
# MAX_SPEECH_SEC in total; shorter or quieter input never reaches the model.
S2T_VOICEPRINT_MIN_SEGMENT_SEC=1.5
S2T_VOICEPRINT_MIN_BLOCK_SEC=5
S2T_VOICEPRINT_MAX_BLOCK_SEC=15
S2T_VOICEPRINT_MAX_BLOCKS=3
S2T_VOICEPRINT_MIN_SPEECH_SEC=8
S2T_VOICEPRINT_MAX_SPEECH_SEC=45
S2T_VOICEPRINT_MIN_BLOCK_DBFS=-45
# Optional Silero gate: runs on the selected blocks only, never on the whole
# recording, and requires this share of the block to be speech.
S2T_VOICEPRINT_VAD=0
S2T_VOICEPRINT_VAD_MIN_RATIO=0.6
# Recording-level veto (default on): one Silero pass over the whole recording
# skips voiceprint labelling when it holds almost no speech, which is what
# music does (measured: a duet track is 5.8 s voiced out of 238 s, and an
# instrumental passage scored 0.702 against an enrolled voice — above the 0.65
# threshold). Set to 0 to label anyway; the two limits below are AND-ed.
S2T_VOICEPRINT_AUDIO_VAD=1
S2T_VOICEPRINT_AUDIO_VAD_MIN_SEC=10
S2T_VOICEPRINT_AUDIO_VAD_MIN_RATIO=0.05

# Shared root for sherpa-onnx/, silero-vad/, nemotron-3-diarization/ + runtime.
# Default: <working directory>/models. Container example: /models.
S2T_MODELS_DIR=./models
# Legacy sherpa-only override; kept for compatibility. Explicit per-file
# overrides win over legacy directory, which wins over the shared root.
S2T_SHERPA_MODELS_DIR=
S2T_SHERPA_SEGMENTATION_MODEL=
S2T_SHERPA_EMBEDDING_MODEL=

# Shared audio CPU worker pools (legacy S2T_SHERPA_* names). Heavy also runs
# Nemotron; workers/queues/timeouts apply to both diarization backends.
# Two pools: heavy (diarization, voiceprint
# blocks) and interactive (Silero VAD, voiceprint registration, status), so a
# long job cannot stall an interactive request. Per-job timeout is
#   BASE_MS + audio_seconds x PER_AUDIO_SEC, capped by JOB_TIMEOUT_MS
# (status-only jobs always get 10 s). Raise workers only after scaling CPU.
S2T_SHERPA_WORKERS=1
S2T_SHERPA_FAST_WORKERS=1
S2T_SHERPA_MAX_QUEUE=8
S2T_SHERPA_JOB_TIMEOUT_MS=1800000
S2T_SHERPA_JOB_TIMEOUT_BASE_MS=60000
S2T_SHERPA_JOB_TIMEOUT_PER_AUDIO_SEC=400
# Interactive-pool queue and timeout cap (settings, enrolment, VAD answers).
# The pool runs the same 60 s + 400 ms-per-audio-second formula, capped here;
# keep it above 60000 so short interactive jobs are never cut off.
S2T_SHERPA_FAST_MAX_QUEUE=8
S2T_SHERPA_FAST_JOB_TIMEOUT_MS=120000
# Recording reuse inside each worker (milliseconds / entries / MiB).
S2T_SHERPA_AUDIO_TTL_MS=300000
S2T_SHERPA_AUDIO_CACHE_ENTRIES=4
S2T_SHERPA_AUDIO_CACHE_MB=1024
# Sherpa-only clustering; has no effect on Nemotron.
# Anonymous speaker clustering cut-off: higher merges into fewer speakers.
# Unset = adaptive by recording length (recommended): 0.7 when the input is
# <= S2T_SHERPA_SHORT_AUDIO_SEC, otherwise 0.8. A live-preview window only has
# a handful of segments, so merging hard there glues different people together;
# a full recording has enough evidence to merge aggressively.
# Pin a single value only for A/B runs, with:
#   npm run diarization:eval:timeline -- --tsv <時間軸.tsv> --audio <來源.wav>
#   npm run diarization:eval:corpus  -- --tsv-dir <dir> --audio-dir <dir> --ids <id,...>
#S2T_SHERPA_CLUSTERING_THRESHOLD=0.7
S2T_SHERPA_SHORT_AUDIO_SEC=60
# Sherpa's segmentation post-processing: drop speaker runs shorter than this
# many seconds (on) and bridge gaps shorter than this (off). Raising `on` merges
# away the sub-second fragments that otherwise scatter one voice across dozens
# of labels — but it is read only when the diarizer is constructed, and
# setConfig() does not pick it up, so changing it needs a restart.
#S2T_SHERPA_MIN_DURATION_ON=0.25
#S2T_SHERPA_MIN_DURATION_OFF=0.35
# Shutdown waits for a worker that is still inside sherpa's synchronous native
# call; terminating it aborts the process with SIGABRT. Exceeding this grace
# logs a warning and recovers anyway.
S2T_SHERPA_CLOSE_GRACE_MS=15000
# Threads affect sherpa only, not the native Nemotron CPU runtime.
# Optional inference threads per sherpa model (embedding/diarization). Keep the
# product of workers x threads within the Pod CPU limit to avoid oversubscription.
S2T_SHERPA_INFER_THREADS=2

# Silero single-file override; empty = <S2T_MODELS_DIR>/silero-vad/silero_vad.onnx.
# The checksum must match the file bytes
# (the gateway refuses to load a model whose sha256 differs).
S2T_SILERO_VAD_MODEL=
S2T_SILERO_VAD_SHA256=1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3

# Migration tooling. Leave empty unless migrating local fallback data.
S2T_STORAGE_ENV_FILE=
S2T_MIGRATION_SOURCE_DIR=
S2T_MIGRATION_SCOPE_MAP_JSON=

# Smoke-test endpoints. These are only read by the storage test scripts.
S2T_COMPENSATION_SMOKE_BASE=
S2T_CAS_SCOPE=
S2T_CAS_WRITER=
S2T_LOCAL_CAS_DIRECTORY=
S2T_LOCAL_CAS_WRITER=

# Gateway capacity probe (`npm run capacity:gateway`). BASE_URL, TOKEN and WAV
# are required; the remaining values are optional with the defaults shown.
# concurrency 1..100, duration in seconds (>=1), interval in ms (>=100).
S2T_LOAD_BASE_URL=
S2T_LOAD_TOKEN=
S2T_LOAD_WAV=
S2T_LOAD_CONCURRENCY=1
S2T_LOAD_DURATION_SECONDS=60
S2T_LOAD_INTERVAL_MS=1000
S2T_LOAD_TRANSLATION_TEXT=Load test caption.

# Sidebar title PNG, relative to project root; blank keeps the text title.
S2T_PRODUCT_TITLE_IMAGE=icon/product_design_title.png
