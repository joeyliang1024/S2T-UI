# 請複製為 .env 後填入實際值；不要提交 .env。Electron 與 Web gateway 共用這些設定。
S2T_ASR_API_KEY=
S2T_ASR_ENDPOINT=https://host.example/v1/audio/transcriptions
S2T_ASR_MODEL=

S2T_TRANSLATION_API_KEY=
S2T_TRANSLATION_ENDPOINT=https://host.example/v1/chat/completions
S2T_TRANSLATION_MODEL=

S2T_SUMMARY_API_KEY=
S2T_SUMMARY_ENDPOINT=https://host.example/v1/chat/completions
S2T_SUMMARY_MODEL=

# 留空即可使用內建 sherpa-onnx；遠端服務則填三個欄位。
S2T_DIARIZATION_API_KEY=
S2T_DIARIZATION_ENDPOINT=
S2T_DIARIZATION_MODEL=

# Web gateway 設定。API key 不會傳到瀏覽器，也不需要 VITE_ 變數。
S2T_WEB_PORT=8787
# Add the packaged Electron origin (normally `null`) only when required by
# the deployed gateway's CORS policy.
S2T_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required by packaged Electron. This is an external HTTPS gateway; Electron
# never starts an embedded production gateway. Local HTTP is development-only.
S2T_GATEWAY_URL=https://gateway.example

# Set a long, random value for deployments. In local development a private
# value is generated under S2T_LOCAL_DATA_DIR so sessions survive restarts.
S2T_AUTH_SECRET=
S2T_BOOTSTRAP_ADMIN_USERNAME=admin
S2T_BOOTSTRAP_ADMIN_PASSWORD=admin

# Storage. Each service uses the local test adapter when every variable in its
# group is empty. Do not partially configure a group.
S2T_MINIO_ENDPOINT=http://127.0.0.1:9000
S2T_MINIO_BUCKET=s2t-audio
S2T_MINIO_ACCESS_KEY=s2t-local-minio
S2T_MINIO_SECRET_KEY=replace-with-a-local-minimum-12-character-secret

S2T_POSTGRES_HOST=127.0.0.1
S2T_POSTGRES_PORT=5432
S2T_POSTGRES_DB_NAME=s2t
S2T_POSTGRES_USER=s2t
S2T_POSTGRES_PASSWORD=replace-with-a-local-password

S2T_MILVUS_ENDPOINT=127.0.0.1:19530
S2T_MILVUS_DB_NAME=default
S2T_MILVUS_COLLECTION=s2t_voiceprints
S2T_MILVUS_TOKEN=local-milvus-token

# Optional local storage location for development and tests.
S2T_LOCAL_DATA_DIR=.s2t-data
