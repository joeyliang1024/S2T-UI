# 複製為 backend/.env，依部署填入；不要提交真實密碼或 API key。
# 所有預設調校參數見 docs/guide/ENVIRONMENT-OPTIONS.zh-TW.md。

# --- 根目錄：相對路徑與 ~/ 自動解析，子目錄與模型檔案路徑自動衍生 ---
S2T_MODEL_DIR=./models
S2T_DATA_DIR=./data
# 留空時使用 ${S2T_DATA_DIR}/jargon/jargon_en.csv；容器預設為 /data/jargon/jargon_en.csv。
S2T_JARGON_FILE=

# --- 模型連線：使用環境預設模型時填寫，也可由帳號模型設定管理 ---
# ASR endpoint 例：https://host.example/v1/audio/transcriptions
S2T_ASR_ENDPOINT=
S2T_ASR_MODEL=
S2T_ASR_API_KEY=
# 多個 ASR profile 的 JSON 陣列；單一模型可留空。
S2T_ASR_MODELS_JSON=
# 翻譯／摘要 endpoint 例：https://host.example/v1/chat/completions
S2T_TRANSLATION_ENDPOINT=
S2T_TRANSLATION_MODEL=
S2T_TRANSLATION_API_KEY=
S2T_SUMMARY_ENDPOINT=
S2T_SUMMARY_MODEL=
S2T_SUMMARY_API_KEY=
# 本機分離：MODEL 選 nemotron-3-diarization 或 sherpa-onnx-speaker-diarization，
# ENDPOINT／API_KEY 留空；三項全空時使用 sherpa。遠端則依服務填寫。
S2T_DIARIZATION_ENDPOINT=
S2T_DIARIZATION_MODEL=
S2T_DIARIZATION_API_KEY=

# --- 部署連線與登入 ---
# 前端環境變數位於 frontend/.env。
# 允許的瀏覽器 origin，逗號分隔。
S2T_WEB_ORIGINS=
# Python 監聽埠，啟動時由此環境變數載入。
BACKEND_PORT=8787
# Web 的前端由 Nginx 提供；Python API 預設為 8787。
# 每個 Pod 一個 Uvicorn 程序；以副本數擴充。
S2T_HTTP_MAX_CONCURRENCY=1024
S2T_HTTP_MAX_WAITING=512
S2T_POSTGRES_POOL_MAX=16
S2T_POSTGRES_FENCE_SESSIONS=4
S2T_AUDIO_LIGHT_WORKERS=1
S2T_AUDIO_HEAVY_WORKERS=1
S2T_SHUTDOWN_GRACE_SECONDS=660
# 正式部署使用長且隨機的共用密鑰；首次建立管理員時填帳密（密碼至少 12 字元）。
S2T_AUTH_SECRET=
S2T_BOOTSTRAP_ADMIN_USERNAME=
S2T_BOOTSTRAP_ADMIN_PASSWORD=
# 自行建置 Docker image 時，必須填寫可連線的 npm registry URL。

# --- 遠端儲存連線：每組全填或全空；全空使用本機儲存 ---
S2T_MINIO_ENDPOINT=
S2T_MINIO_BUCKET=
S2T_MINIO_ACCESS_KEY=
S2T_MINIO_SECRET_KEY=
S2T_POSTGRES_HOST=
S2T_POSTGRES_PORT=
S2T_POSTGRES_DB_NAME=
S2T_POSTGRES_USER=
# 必須符合既有資料庫角色的密碼；修改 env 不會重設既有 volume 的密碼。
S2T_POSTGRES_PASSWORD=
S2T_MILVUS_ENDPOINT=
S2T_MILVUS_DB_NAME=
S2T_MILVUS_COLLECTION=
S2T_MILVUS_TOKEN=

# --- K8s／分層部署：單機可整段留空 ---
# 啟用填 true；需要共用 MinIO／PostgreSQL、AUTH_SECRET 與 Redis；Milvus 可選。
S2T_KUBERNETES_MODE=
# all／api／audio-service／audio-worker；留空為 all。
S2T_PROCESS_ROLE=
# K8s 的 api 必填音訊服務 URL；api 與 audio-service 使用相同 token。
S2T_AUDIO_SERVICE_URL=
S2T_AUDIO_SERVICE_TOKEN=
# migration Job 完成後填 verify；留空使用啟動時自動 migration。
S2T_STORAGE_MIGRATIONS=
# Redis URL 或 Sentinel 擇一。URL 例：redis://user:password@redis:6379/0
REDIS_URL=
# Sentinel 填 host:port 清單（逗號分隔）與 master name。
REDIS_SENTINEL_NODES=
REDIS_SERVICE_NAME=
# Sentinel 與資料節點認證分開；PASSWARD 為程式目前支援的拼字。
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWARD=
REDIS_SENTINEL_TLS=
REDIS_USERNAME=
REDIS_PASSWARD=
REDIS_TLS=

# Process descriptor budget for concurrent HTTP/model/storage sockets.
S2T_NOFILE=8192

# Per-Pod workers; size all SQL/audio pools across replicas × workers.
S2T_WEB_WORKERS=1

# Per-worker active HTTP budget; queues before authentication/SQL, excludes probes.
S2T_HTTP_ACTIVE_PER_WORKER=64
