# 複製為 .env.local-storage 後使用。這個檔案不會被 gateway 自動合併，
# 由 compose 與明確選用的工具流程讀取（docs/guide/ENVIRONMENT.zh-TW.md）：
#
#   docker-compose --env-file .env.local-storage -f docker-compose.local-storage.yml up -d
#   set -a; source .env.local-storage; set +a
#   npm run web:serve
#
# 不要提交 .env.local-storage。若沿用既有資料卷，MinIO／PostgreSQL 的帳密
# 必須與建立資料卷時使用的相同，否則服務會因為認證失敗而無法啟動。

# --- 本機 Storage（與 docker-compose.local-storage.yml 對應） ---
# 下列是 compose 的預設值，直接啟動即可。自行替換時請同步修改 compose 的
# --env-file，不要只改其中一邊。某一組全部留空時該服務退回本機 fallback；
# 不可只填同組的一部分。
S2T_MINIO_ENDPOINT=http://127.0.0.1:9000
S2T_MINIO_BUCKET=s2t-audio
S2T_MINIO_ACCESS_KEY=s2t-local-minio
S2T_MINIO_SECRET_KEY=s2t-local-minio-secret

S2T_POSTGRES_HOST=127.0.0.1
S2T_POSTGRES_PORT=5432
S2T_POSTGRES_DB_NAME=s2t
S2T_POSTGRES_USER=s2t
S2T_POSTGRES_PASSWORD=s2t-local-postgres-secret
# 遠端 PostgreSQL adapter 的連線池上限，留空用預設 10。
S2T_POSTGRES_MAX_CONNECTIONS=

# Milvus 只在啟用 --profile milvus 時需要；未啟用時留空不影響其他服務。
S2T_MILVUS_ENDPOINT=127.0.0.1:19530
S2T_MILVUS_DB_NAME=default
S2T_MILVUS_COLLECTION=s2t_voiceprints
S2T_MILVUS_TOKEN=local-milvus-token

# --- 本機資料與模型 ---
S2T_MODELS_DIR=./models
S2T_LOCAL_DATA_DIR=.s2t-data

# --- Web gateway ---
S2T_WEB_PORT=8787
S2T_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 留空時會在 S2T_LOCAL_DATA_DIR 產生私鑰，session 因此可以在重啟後保留。
# 對外部署請自行設定一組長且隨機的值。
S2T_AUTH_SECRET=
S2T_BOOTSTRAP_ADMIN_USERNAME=admin
S2T_BOOTSTRAP_ADMIN_PASSWORD=admin

# 本機限流。Silero VAD 與上面兩個不同：S2T_KUBERNETES_MODE=false 時預設 30。
S2T_ASR_REQUESTS_PER_MINUTE=180
S2T_TRANSLATION_REQUESTS_PER_MINUTE=180
S2T_VAD_REQUESTS_PER_MINUTE=30

# --- 模型供應商 ---
# 範例一律留空，示範網址只放註解，避免複製後變成半套模型設定。
#   ASR     : https://host.example/v1/audio/transcriptions
#   翻譯     : https://host.example/v1/chat/completions
S2T_ASR_API_KEY=
S2T_ASR_ENDPOINT=
S2T_ASR_MODEL=
S2T_TRANSLATION_API_KEY=
S2T_TRANSLATION_ENDPOINT=
S2T_TRANSLATION_MODEL=
S2T_SUMMARY_API_KEY=
S2T_SUMMARY_ENDPOINT=
S2T_SUMMARY_MODEL=

# 講者分離。本機 CPU 用 nemotron-3-diarization，endpoint 與 API key 留空即可；
# 換模型或改路徑後要重啟 gateway 才會生效。
S2T_DIARIZATION_API_KEY=
S2T_DIARIZATION_ENDPOINT=
S2T_DIARIZATION_MODEL=nemotron-3-diarization

# 分散式設定（Redis）在本機 Storage 模式用不到，全部留空。
REDIS_URL=
REDIS_SENTINEL_NODES=
REDIS_SERVICE_NAME=
