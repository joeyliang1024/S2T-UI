{
  "name": "s2t-ui",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Web speech-to-text and translation with a Python backend",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Joey Liang",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:frontend": "vite --config config/vite.web.config.ts",
    "dev:backend": "node scripts/backend.cjs",
    "build": "vite build --config config/vite.web.config.ts",
    "build:web": "npm run build",
    "preview": "vite preview --config config/vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/testing/run-tests.cjs unit",
    "test:backend": "node scripts/backend.cjs --test",
    "test:e2e": "node scripts/testing/run-tests.cjs e2e",
    "check:architecture": "node scripts/analysis/check-architecture.cjs",
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run build",
    "docker:up": "node scripts/compose.cjs up -d --build",
    "docker:down": "node scripts/compose.cjs down",
    "k8s:up": "node scripts/k8s.cjs up",
    "k8s:down": "node scripts/k8s.cjs down",
    "k8s:forward": "node scripts/forward.cjs",
    "test:dev": "node tests/integration/dev-launcher.cjs",
    "test:deployment": "node tests/integration/web-deployment.cjs",
    "test:replicas": "node tests/integration/replicas.cjs",
    "test:monitoring": "node tests/integration/monitoring.cjs",
    "test:proxy": "node tests/integration/nginx-upstream.cjs",
    "test:load:k8s": "node scripts/benchmarks/k8s/recording-load.cjs"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "dotenv": "^18.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "file:dependencies/npm/xlsx-0.20.3.tgz",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
