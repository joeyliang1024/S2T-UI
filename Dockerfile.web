# Production Web gateway image. Models deliberately remain outside this image:
# mount the output of Dockerfile.sherpa-models at /models read-only, or use an
# equivalent approved artifact volume in Kubernetes.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    S2T_WEB_PORT=8787 \
    S2T_SHERPA_MODELS_DIR=/models/sherpa-onnx \
    S2T_SILERO_VAD_MODEL=/models/silero-vad/silero_vad.onnx
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/out ./out
COPY server ./server
EXPOSE 8787
CMD ["node", "server/index.cjs"]
