# Linux x64 publication image. Build the platform-independent Web assets first.
# The digest records the audited base; apk upgrade refreshes available fixes.
FROM cgr.dev/chainguard/wolfi-base@sha256:c2a4815b6ca49b9bbafd451b4bde690d567a86b2b6b54877faac8082a7bc4296 AS dependencies
USER root
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache nodejs-26 npm ca-certificates libstdc++ libgcc libgomp libatomic
WORKDIR /app
COPY package.json package-lock.json ./
COPY dependencies/npm ./dependencies/npm
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org/

FROM cgr.dev/chainguard/wolfi-base@sha256:c2a4815b6ca49b9bbafd451b4bde690d567a86b2b6b54877faac8082a7bc4296
USER root
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache nodejs-26 ca-certificates curl wget jq bash ffmpeg libstdc++ libgcc libgomp libatomic \
    && mkdir -p /app /data && chown -R nonroot:nonroot /app /data
WORKDIR /app
ENV NODE_ENV=production S2T_WEB_PORT=8787 S2T_DATA_DIR=/data S2T_MODEL_DIR=/models
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY out/web ./out/web
COPY server ./server
COPY src/shared/validation ./src/shared/validation
COPY scripts/storage ./scripts/storage
COPY data ./data
COPY icon ./icon
COPY LICENSE ./LICENSE
RUN ln -s /usr/bin/ffmpeg node_modules/ffmpeg-static/ffmpeg
USER nonroot
EXPOSE 8787
CMD ["node", "server/index.cjs"]
