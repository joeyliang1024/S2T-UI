                  "sh",
                  "-c",
                  "set -eu\nmaster=\"\"\nfor i in 0 1 2; do\n master=$(redis-cli -h sentinel-$i.sentinel -p 26379 -a \"$SENTINEL_PASSWORD\" --no-auth-warning --raw SENTINEL get-master-addr-by-name s2t-stress-master 2>/dev/null | head -n 1) || true\n [ -n \"$master\" ] && break\ndone\nif [ -z \"$master\" ]; then master=redis-0.redis.s2t-stress-20261005.svc.cluster.local; fi\nown=\"$HOSTNAME.redis.s2t-stress-20261005.svc.cluster.local\"\nif [ \"$master\" = \"$own\" ]; then\n exec redis-server --requirepass \"$REDIS_PASSWORD\" --masterauth \"$REDIS_PASSWORD\" --appendonly yes --dir /data --replica-announce-ip \"$own\" --replica-announce-port 6379\nelse\n exec redis-server --requirepass \"$REDIS_PASSWORD\" --masterauth \"$REDIS_PASSWORD\" --appendonly yes --dir /data --replicaof \"$master\" 6379 --replica-announce-ip \"$own\" --replica-announce-port 6379\nfi"
                ],
                "volumeMounts": [
