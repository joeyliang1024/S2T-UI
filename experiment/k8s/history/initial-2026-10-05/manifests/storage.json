                "command": [
                  "sh",
                  "-c",
                  "set -eu\nif [ ! -f /data/sentinel.conf ]; then\ncat > /data/sentinel.conf <<CFG\nport 26379\nbind 0.0.0.0\nprotected-mode yes\nrequirepass $SENTINEL_PASSWORD\nsentinel resolve-hostnames yes\nsentinel announce-hostnames yes\nsentinel announce-ip $HOSTNAME.sentinel.s2t-stress-20261005.svc.cluster.local\nsentinel monitor s2t-stress-master redis-0.redis.s2t-stress-20261005.svc.cluster.local 6379 2\nsentinel auth-pass s2t-stress-master $REDIS_PASSWORD\nsentinel sentinel-pass $SENTINEL_PASSWORD\nsentinel down-after-milliseconds s2t-stress-master 2000\nsentinel failover-timeout s2t-stress-master 15000\nsentinel parallel-syncs s2t-stress-master 1\nCFG\nfi\nsed -i '/^sentinel announce-ip /d; /^sentinel announce-hostnames /d; /^sentinel resolve-hostnames /d' /data/sentinel.conf\nprintf 'sentinel resolve-hostnames yes\\nsentinel announce-hostnames yes\\nsentinel announce-ip %s\\n' \"$HOSTNAME.sentinel.s2t-stress-20261005.svc.cluster.local\" >> /data/sentinel.conf\nexec redis-server /data/sentinel.conf --sentinel"
                ],
