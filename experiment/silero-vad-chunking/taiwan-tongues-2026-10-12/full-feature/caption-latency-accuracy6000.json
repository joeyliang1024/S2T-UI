      "text": "重心會出力"
    },
    {
      "startMs": 2960,
      "endMs": 7600,
      "text": "以及中央研究院老師"
    },
    {
      "startMs": 7600,
      "endMs": 10560,
      "text": "小編不錯吧"
    },
    {
      "startMs": 10560,
      "endMs": 14340,
      "text": "中華民國訓政時期約法"
    },
    {
      "startMs": 14340,
      "endMs": 20340,
      "text": "獲選的是歷史社會最引起人期待的提案"
    },
    {
      "startMs": 20680,
      "endMs": 25360,
      "text": "為了端絕合政府現有資源"
    },
    {
      "startMs": 25360,
      "endMs": 30060,
      "text": "高雄捷運東港林真線"
    },
    {
      "startMs": 30060,
      "endMs": 34700,
      "text": "今日能否提出名單"
    },
    {
      "startMs": 34700,
      "endMs": 40340,
      "text": "決定以此復興社區"
    },
    {
      "startMs": 40340,
      "endMs": 43880,
      "text": "保證會給利息"
    },
    {
      "startMs": 43880,
      "endMs": 47720,
      "text": "如人員願意投入"
    },
    {
      "startMs": 47720,
      "endMs": 51160,
      "text": "非精神疾病"
    },
    {
      "startMs": 51160,
      "endMs": 54740,
      "text": "很多人都是當了父母"
    },
    {
      "startMs": 54740,
      "endMs": 58360,
      "text": "緊張的情緒"
    },
    {
      "startMs": 58360,
      "endMs": 61720,
      "text": "好孩子 請不要模仿"
    },
    {
      "startMs": 61720,
      "endMs": 64700,
      "text": "大家都在看黑洞"
    },
    {
      "startMs": 64700,
      "endMs": 68020,
      "text": "賭博的人都十分高興"
    },
    {
      "startMs": 68020,
      "endMs": 72360,
      "text": "誤打誤撞買到轉成券"
    },
    {
      "startMs": 72360,
      "endMs": 75660,
      "text": "讓使用者信任"
    },
    {
      "startMs": 75660,
      "endMs": 80460,
      "text": "套福一顆 90 日幣"
    },
    {
      "startMs": 80460,
      "endMs": 83560,
      "text": "分類意志的思想"
    },
    {
      "startMs": 83560,
      "endMs": 86380,
      "text": "就是為了吃豬肉"
    },
    {
      "startMs": 86380,
      "endMs": 89660,
      "text": "日子平安"
    },
    {
      "startMs": 89660,
      "endMs": 91960,
      "text": "什麼班"
    },
    {
      "startMs": 91960,
      "endMs": 96020,
      "text": "原本和廢料還要運去"
    },
    {
      "startMs": 96020,
      "endMs": 99420,
      "text": "信用卡"
    },
    {
      "startMs": 99420,
      "endMs": 104360,
      "text": "能夠把內容給外國朋友了解"
    },
    {
      "startMs": 104360,
      "endMs": 107800,
      "text": "基本介紹範本"
    },
    {
      "startMs": 107800,
      "endMs": 111680,
      "text": "這個我笑了"
    },
    {
      "startMs": 111680,
      "endMs": 114520,
      "text": "能表達我的心情"
    },
    {
      "startMs": 114520,
      "endMs": 119720,
      "text": "這是我 14 年前體悟的道理"
    },
    {
      "startMs": 119720,
      "endMs": 123780,
      "text": "使用手機的比例"
    },
    {
      "startMs": 123780,
      "endMs": 125960,
      "text": "5 5 4 3"
    },
    {
      "startMs": 125960,
      "endMs": 136660,
      "text": "要是你不願意花錢買就第一代南方澳大橋"
    },
    {
      "startMs": 137500,
      "endMs": 140100,
      "text": "於一定規模下"
    },
    {
      "startMs": 140100,
      "endMs": 143440,
      "text": "這些人到處留言"
    },
    {
      "startMs": 143440,
      "endMs": 147660,
      "text": "奧迪北區股份有限公司"
    },
    {
      "startMs": 147660,
      "endMs": 151540,
      "text": "對於政治上的權益也諸多壓制"
    },
    {
      "startMs": 151540,
      "endMs": 155100,
      "text": "卻接到爸爸打來的電話"
    },
    {
      "startMs": 155100,
      "endMs": 160060,
      "text": "就必須從現在起就下定決心"
    },
    {
      "startMs": 160060,
      "endMs": 163320,
      "text": "回程我兒子一直和腳酸"
    },
    {
      "startMs": 163320,
      "endMs": 167100,
      "text": "收集資料並做整合"
    },
    {
      "startMs": 167100,
      "endMs": 172340,
      "text": "希望如何調配這三元素的比重"
    },
    {
      "startMs": 172340,
      "endMs": 176860,
      "text": "狗言慘喘的生命獲得延續"
    },
    {
      "startMs": 176860,
      "endMs": 180880,
      "text": "至少都比其他新聞台好"
    },
    {
      "startMs": 180880,
      "endMs": 184780,
      "text": "談話的用意是"
    },
    {
      "startMs": 184780,
      "endMs": 188660,
      "text": "基本上這是一個體制外的會議"
    },
    {
      "startMs": 188660,
      "endMs": 192400,
      "text": "無法看見未來的結果"
    },
    {
      "startMs": 192400,
      "endMs": 196020,
      "text": "社會秩序失調困境"
    },
    {
      "startMs": 196020,
      "endMs": 198740,
      "text": "他還是在台北過得很好"
    },
    {
      "startMs": 198740,
      "endMs": 202160,
      "text": "法官是社會公正的人士"
    },
    {
      "startMs": 202160,
      "endMs": 206400,
      "text": "過程中有人不斷教唆群眾"
    },
    {
      "startMs": 206400,
      "endMs": 210940,
      "text": "難道你要他一個人煮全家人的飯"
    },
    {
      "startMs": 210940,
      "endMs": 213280,
      "text": "你趕快回來"
    },
    {
      "startMs": 213280,
      "endMs": 215600,
      "text": "真人呢"
    },
    {
      "startMs": 215600,
      "endMs": 219520,
      "text": "他感到全身無力"
    },
    {
      "startMs": 219520,
      "endMs": 222580,
      "text": "據法律團隊的意見"
    },
    {
      "startMs": 222580,
      "endMs": 224760,
      "text": "說什麼話"
    },
    {
      "startMs": 224760,
      "endMs": 228840,
      "text": "新北市立中和高級中學"
    },
    {
      "startMs": 228840,
      "endMs": 232600,
      "text": "讓使用者信任"
    },
    {
      "startMs": 232600,
      "endMs": 236420,
      "text": "絕對沒有賺到很多錢"
    },
    {
      "startMs": 236420,
      "endMs": 239440,
      "text": "學術研討會也能夠報滿"
    },
    {
      "startMs": 239440,
      "endMs": 243360,
      "text": "他妻子受不了而選擇離婚"
    },
    {
      "startMs": 243360,
      "endMs": 246560,
      "text": "在這裡只是浪費時間"
    },
    {
      "startMs": 246560,
      "endMs": 250200,
      "text": "整合串聯工程"
    },
    {
      "startMs": 250200,
      "endMs": 253280,
      "text": "東北地區有異症組"
    },
    {
      "startMs": 253280,
      "endMs": 257240,
      "text": "就差當天沒直接訂"
    },
    {
      "startMs": 257240,
      "endMs": 261740,
      "text": "店表示不再議價直接以原價訂購"
    },
    {
      "startMs": 261740,
      "endMs": 265000,
      "text": "嘉義大學嘉禾館"
    },
    {
      "startMs": 265000,
      "endMs": 269840,
      "text": "有點回音"
    },
    {
      "startMs": 269840,
      "endMs": 273100,
      "text": "今天弟弟給你接"
    },
    {
      "startMs": 273100,
      "endMs": 278060,
      "text": "籌設公司是否符合章程"
    },
    {
      "startMs": 278060,
      "endMs": 281740,
      "text": "記得晾衣服"
    },
    {
      "startMs": 281740,
      "endMs": 285260,
      "text": "不要把骨灰撒在迪士尼樂園"
    },
    {
      "startMs": 285260,
      "endMs": 289480,
      "text": "提出分組付費頻道組合"
    },
    {
      "startMs": 289480,
      "endMs": 292820,
      "text": "他 60 歲時"
    },
    {
      "startMs": 292820,
      "endMs": 297520,
      "text": "兩位靠窗"
    },
    {
      "startMs": 297520,
      "endMs": 301308,
      "text": "做不一樣的事情"
    }
  ],
