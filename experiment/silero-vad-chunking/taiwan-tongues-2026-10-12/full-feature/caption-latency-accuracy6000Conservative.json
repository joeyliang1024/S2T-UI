      "text": "重心會出力"
    },
    {
      "startMs": 3200,
      "endMs": 7840,
      "text": "以及中央研究院老師"
    },
    {
      "startMs": 7840,
      "endMs": 10800,
      "text": "小編不錯吧"
    },
    {
      "startMs": 10800,
      "endMs": 14580,
      "text": "中華民國訓政時期約法"
    },
    {
      "startMs": 14580,
      "endMs": 20580,
      "text": "獲選的是歷史社會最引起人期待的提案"
    },
    {
      "startMs": 20920,
      "endMs": 25600,
      "text": "未來將結合政府現有資源"
    },
    {
      "startMs": 25600,
      "endMs": 30300,
      "text": "高雄捷運東港林真線"
    },
    {
      "startMs": 30300,
      "endMs": 34940,
      "text": "今日能否提出名單"
    },
    {
      "startMs": 34940,
      "endMs": 40580,
      "text": "決定以此復興社區"
    },
    {
      "startMs": 40580,
      "endMs": 44120,
      "text": "保證會給利息"
    },
    {
      "startMs": 44120,
      "endMs": 47960,
      "text": "如人員願意投入"
    },
    {
      "startMs": 47960,
      "endMs": 51400,
      "text": "非精神疾病"
    },
    {
      "startMs": 51400,
      "endMs": 54980,
      "text": "很多人都是當了父母"
    },
    {
      "startMs": 54980,
      "endMs": 58600,
      "text": "緊張的情緒"
    },
    {
      "startMs": 58600,
      "endMs": 61960,
      "text": "好孩子 請不要模仿"
    },
    {
      "startMs": 61960,
      "endMs": 64940,
      "text": "大家都在看黑洞"
    },
    {
      "startMs": 64940,
      "endMs": 68260,
      "text": "賭博的人都十分高興"
    },
    {
      "startMs": 68260,
      "endMs": 72600,
      "text": "誤打誤撞買到轉成券"
    },
    {
      "startMs": 72600,
      "endMs": 76320,
      "text": "讓使用者信任"
    },
    {
      "startMs": 76320,
      "endMs": 80700,
      "text": "套福一顆 90 日幣"
    },
    {
      "startMs": 80700,
      "endMs": 83800,
      "text": "分類意志的思想"
    },
    {
      "startMs": 83800,
      "endMs": 86620,
      "text": "就是為了吃豬肉"
    },
    {
      "startMs": 86620,
      "endMs": 89900,
      "text": "日子平安"
    },
    {
      "startMs": 89900,
      "endMs": 92200,
      "text": "什麼班"
    },
    {
      "startMs": 92200,
      "endMs": 96260,
      "text": "原本和廢料還要運去"
    },
    {
      "startMs": 96260,
      "endMs": 99660,
      "text": "信用卡"
    },
    {
      "startMs": 99660,
      "endMs": 104600,
      "text": "能夠把內容給外國朋友了解"
    },
    {
      "startMs": 104600,
      "endMs": 108040,
      "text": "基本介紹範本"
    },
    {
      "startMs": 108040,
      "endMs": 111920,
      "text": "這個我笑了"
    },
    {
      "startMs": 111920,
      "endMs": 114760,
      "text": "能表達我的心情"
    },
    {
      "startMs": 114760,
      "endMs": 120460,
      "text": "這是我 14 年前體悟的道理"
    },
    {
      "startMs": 120460,
      "endMs": 126520,
      "text": "使用手機的比例孤獨適可使用手機的比例孤獨適可"
    },
    {
      "startMs": 126520,
      "endMs": 137740,
      "text": "要是你不願意花錢買以示溫冷或熱的錢的話第一代南方澳大橋"
    },
    {
      "startMs": 137740,
      "endMs": 140340,
      "text": "於一定規模下"
    },
    {
      "startMs": 140340,
      "endMs": 143680,
      "text": "這些人到處留言"
    },
    {
      "startMs": 143680,
      "endMs": 147900,
      "text": "奧迪北區股份有限公司"
    },
    {
      "startMs": 147900,
      "endMs": 151780,
      "text": "對於政治上的權益也諸多壓制"
    },
    {
      "startMs": 151780,
      "endMs": 155340,
      "text": "卻接到爸爸打來的電話"
    },
    {
      "startMs": 155340,
      "endMs": 160300,
      "text": "就必須從現在起就下定決心"
    },
    {
      "startMs": 160300,
      "endMs": 163560,
      "text": "回程我兒子一直和腳酸"
    },
    {
      "startMs": 163560,
      "endMs": 167340,
      "text": "收集資料並做整合"
    },
    {
      "startMs": 167340,
      "endMs": 172580,
      "text": "希望如何調配這三元素的比重"
    },
    {
      "startMs": 172580,
      "endMs": 177100,
      "text": "狗言慘喘的生命獲得延續"
    },
    {
      "startMs": 177100,
      "endMs": 181120,
      "text": "至少都比其他新聞台好"
    },
    {
      "startMs": 181120,
      "endMs": 185020,
      "text": "談話的用意是"
    },
    {
      "startMs": 185020,
      "endMs": 188900,
      "text": "基本上這是一個體制外的會議"
    },
    {
      "startMs": 188900,
      "endMs": 193140,
      "text": "無法看見未來的結果"
    },
    {
      "startMs": 193140,
      "endMs": 196260,
      "text": "社會秩序失調困境"
    },
    {
      "startMs": 196260,
      "endMs": 198980,
      "text": "他還是在台北過得很好"
    },
    {
      "startMs": 198980,
      "endMs": 202400,
      "text": "法官是社會公正的人士"
    },
    {
      "startMs": 202400,
      "endMs": 206640,
      "text": "過程中有人不斷教唆群眾"
    },
    {
      "startMs": 206640,
      "endMs": 211180,
      "text": "難道你要他一個人煮全家人的飯"
    },
    {
      "startMs": 211180,
      "endMs": 213520,
      "text": "你趕快回來"
    },
    {
      "startMs": 213520,
      "endMs": 215840,
      "text": "真熱鬧"
    },
    {
      "startMs": 215840,
      "endMs": 219760,
      "text": "他感到全身無力"
    },
    {
      "startMs": 219760,
      "endMs": 222820,
      "text": "據法律團隊的意見"
    },
    {
      "startMs": 222820,
      "endMs": 225000,
      "text": "說什麼話"
    },
    {
      "startMs": 225000,
      "endMs": 229080,
      "text": "新北市立中和高級中學"
    },
    {
      "startMs": 229080,
      "endMs": 232840,
      "text": "讓使用者信任"
    },
    {
      "startMs": 232840,
      "endMs": 236660,
      "text": "絕對沒有賺到很多錢"
    },
    {
      "startMs": 236660,
      "endMs": 239680,
      "text": "學術研討會也能夠報滿"
    },
    {
      "startMs": 239680,
      "endMs": 243600,
      "text": "他妻子受不了而選擇離婚"
    },
    {
      "startMs": 243600,
      "endMs": 246800,
      "text": "在這裡只是浪費時間"
    },
    {
      "startMs": 246800,
      "endMs": 250440,
      "text": "整合串聯工程"
    },
    {
      "startMs": 250440,
      "endMs": 253520,
      "text": "東北地區有異症組"
    },
    {
      "startMs": 253520,
      "endMs": 257480,
      "text": "就差當天沒直接訂"
    },
    {
      "startMs": 257480,
      "endMs": 261980,
      "text": "店表示不再議價直接以原價訂購"
    },
    {
      "startMs": 261980,
      "endMs": 265660,
      "text": "嘉義大學嘉禾館"
    },
    {
      "startMs": 265660,
      "endMs": 270080,
      "text": "有點回音"
    },
    {
      "startMs": 270080,
      "endMs": 273340,
      "text": "今天弟弟給你接"
    },
    {
      "startMs": 273340,
      "endMs": 278640,
      "text": "籌設公司是否符合章程"
    },
    {
      "startMs": 278640,
      "endMs": 281980,
      "text": "記得晾衣服"
    },
    {
      "startMs": 281980,
      "endMs": 285500,
      "text": "不要把骨灰撒在迪士尼樂園"
    },
    {
      "startMs": 285500,
      "endMs": 289720,
      "text": "提出分組付費頻道組合"
    },
    {
      "startMs": 289720,
      "endMs": 293060,
      "text": "他 60 歲時"
    },
    {
      "startMs": 293060,
      "endMs": 297760,
      "text": "兩位靠窗"
    },
    {
      "startMs": 297760,
      "endMs": 301308,
      "text": "做不一樣的事情"
    }
  ],
